{% extends "layouts/admin.html.twig" %}

{% block title %}Nuevo Slide{% endblock %}
{% block nav_slides %}active{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="h3 fw-bold text-indigo-900 mb-1">
      <i class="bi bi-plus-circle-fill me-2 text-indigo-600"></i> Nuevo Slide
    </h2>
    <p class="text-muted small mb-0">Agrega una nueva imagen promocional al carrusel principal.</p>
  </div>
  <div>
    <a href="{{ base_url }}/slides" class="btn btn-outline-secondary rounded-pill px-4">
      <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
    </a>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
      <div class="card-header bg-dark text-white py-3">
        <span class="fw-bold"><i class="bi bi-card-image me-2 text-indigo-400"></i> Información del Slide</span>
      </div>
      <div class="card-body p-4">
        <form method="post" enctype="multipart/form-data" action="{{ base_url }}/slide/create">
          {{ csrf_field() }}
          <div class="mb-3">
            <label for="title" class="form-label fw-bold text-indigo-900">Título / Nombre</label>
            <input type="text" class="form-control shadow-none" name="title" id="title" placeholder="Ej: Ofertas de Verano 2026" required>
          </div>

          <div class="mb-3">
            <label for="image" class="form-label fw-bold text-indigo-900">Imagen del Banner</label>
            <input class="form-control shadow-none" type="file" name="image" id="image" required>
            <div class="form-text">Recomendado: Imágenes horizontales en resolución 1920x600 o similar.</div>
          </div>

          <div class="mb-4">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="is_public" id="is_public" checked>
              <label class="form-check-label fw-bold text-indigo-900" for="is_public">Es Visible al Público</label>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a href="{{ base_url }}/slides" class="btn btn-light rounded-pill px-4">Cancelar</a>
            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
              <i class="bi bi-check-lg me-1"></i> Guardar Slide
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}

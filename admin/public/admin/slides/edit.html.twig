{% extends "layouts/admin.html.twig" %}

{% block title %}Editar Slide{% endblock %}
{% block nav_slides %}active{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="h3 fw-bold text-indigo-900 mb-1">
      <i class="bi bi-pencil-square me-2 text-indigo-600"></i> Editar Slide
    </h2>
    <p class="text-muted small mb-0">Modifica el título, estado o reemplaza la imagen del banner promocional.</p>
  </div>
  <div>
    <a href="{{ base_url }}/slides" class="btn btn-outline-secondary rounded-pill px-4">
      <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
    </a>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
      <div class="card-header bg-dark text-white py-3">
        <span class="fw-bold"><i class="bi bi-card-image me-2 text-indigo-400"></i> Editar Información del Slide</span>
      </div>
      <div class="card-body p-4">
        <form method="post" action="{{ base_url }}/slide/{{ slide.id }}/update" enctype="multipart/form-data">
          {{ csrf_field() }}

          <div class="mb-3">
            <label for="title" class="form-label fw-bold text-indigo-900">Título / Nombre</label>
            <input type="text" class="form-control shadow-none" name="title" value="{{ slide.title }}" id="title" required>
          </div>

          {% if slide.image %}
          <div class="mb-3">
            <label class="form-label fw-bold text-indigo-900 d-block">Imagen Actual</label>
            <img src="{{ base_url }}/../storage/slides/{{ slide.image }}" class="img-fluid rounded border shadow-sm mb-2" style="max-height: 200px; object-fit: cover;">
          </div>
          {% endif %}

          <div class="mb-3">
            <label for="image" class="form-label fw-bold text-indigo-900">Reemplazar Imagen (Opcional)</label>
            <input class="form-control shadow-none" type="file" name="image" id="image">
            <div class="form-text">Déjalo vacío si deseas conservar la imagen actual.</div>
          </div>

          <div class="mb-4">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="is_public" id="is_public" {% if slide.is_public %}checked{% endif %}>
              <label class="form-check-label fw-bold text-indigo-900" for="is_public">Es Visible al Público</label>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a href="{{ base_url }}/slides" class="btn btn-light rounded-pill px-4">Cancelar</a>
            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
              <i class="bi bi-save me-1"></i> Actualizar Slide
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}

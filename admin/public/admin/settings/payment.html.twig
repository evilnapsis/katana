{% extends "layouts/admin.html.twig" %}

{% block title %}Métodos de Pago{% endblock %}
{% block nav_settings %}active{% endblock %}

{% block content %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
  <div>
    <h2 class="h3 fw-bold text-indigo-900 mb-1">
      <i class="bi bi-credit-card me-2 text-indigo-600"></i> Métodos de Pago
    </h2>
    <p class="text-muted small mb-0">Habilitación y configuración de opciones de pago para el checkout de los clientes.</p>
  </div>
  <div class="btn-group shadow-sm rounded-pill p-1 bg-white border" role="group">
    <a href="{{ base_url }}/settings" class="btn btn-light rounded-pill px-3 py-1 btn-sm text-muted">
      <i class="bi bi-sliders me-1"></i> General
    </a>
    <a href="{{ base_url }}/settings/payment" class="btn btn-indigo rounded-pill px-3 py-1 btn-sm">
      <i class="bi bi-credit-card me-1"></i> Métodos de Pago
    </a>
  </div>
</div>

{# Banner de Upsell a Katana Pro #}
<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm" style="border-radius: 16px; background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);">
      <div class="card-body p-4 text-white d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
          <div class="d-flex align-items-center mb-2">
            <span class="badge bg-warning text-dark px-2 py-1 rounded-pill fw-bold me-2" style="font-size: 11px;">KATANA PRO</span>
            <h5 class="fw-bold mb-0 text-white">¿Deseas cobrar en línea con tarjeta de crédito/débito?</h5>
          </div>
          <p class="text-white text-opacity-75 small mb-0">
            Desbloquea cobros automáticos en línea con pasarelas <strong>PayPal</strong> y <strong>MercadoPago</strong>, cupones de descuento, subcategorías y galería múltiple adquiriendo la versión premium.
          </p>
        </div>
        <div class="flex-shrink-0">
          <a href="https://evilnapsis.com/product/katana/" target="_blank" rel="noopener noreferrer" class="btn btn-warning fw-bold rounded-pill px-4 shadow">
            <i class="bi bi-star-fill me-1"></i> Ver Katana Pro
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
      <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold text-white"><i class="bi bi-wallet2 me-2 text-indigo-400"></i> Medios de Pago Disponibles</span>
        <span class="badge bg-secondary rounded-pill">{{ paymethods|length }} opciones</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
              <tr>
                <th class="ps-4">Método de Pago</th>
                <th>Identificador</th>
                <th class="text-center">Estado</th>
                <th class="text-center pe-4" style="width: 150px;">Acción</th>
              </tr>
            </thead>
            <tbody>
              {% for pay in paymethods %}
              <tr>
                <td class="ps-4">
                  <div class="fw-bold text-dark">{{ pay.name }}</div>
                </td>
                <td><code class="text-muted small font-monospace">{{ pay.short_name }}</code></td>
                <td class="text-center">
                  {% if pay.is_active %}
                    <span class="badge bg-emerald-100 text-emerald-700 rounded-pill"><i class="bi bi-check-circle"></i> Habilitado</span>
                  {% else %}
                    <span class="badge bg-rose-100 text-rose-700 rounded-pill"><i class="bi bi-x-circle"></i> Deshabilitado</span>
                  {% endif %}
                </td>
                <td class="text-center pe-4">
                  <form method="post" action="{{ base_url }}/settings/paymethod/{{ pay.id }}/toggle">
                    {{ csrf_field() }}
                    {% if pay.is_active %}
                      <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3">
                        <i class="bi bi-pause-fill me-1"></i> Desactivar
                      </button>
                    {% else %}
                      <button type="submit" class="btn btn-sm btn-indigo rounded-pill px-3 shadow-sm">
                        <i class="bi bi-play-fill me-1"></i> Activar
                      </button>
                    {% endif %}
                  </form>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

{% if bank_active %}
<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
      <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold text-white"><i class="bi bi-bank me-2 text-indigo-400"></i> Datos para Depósito o Transferencia Bancaria</span>
        <span class="badge bg-success rounded-pill text-white">Activo</span>
      </div>
      <div class="card-body p-0">
        <form method="post" action="{{ base_url }}/settings/payment/update">
          {{ csrf_field() }}
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <tbody>
                {% for s in bank_settings %}
                <tr>
                  <td class="ps-4" style="width: 35%;">
                    <div class="fw-bold text-dark">{{ s.label }}</div>
                    <code class="text-muted small font-monospace" style="font-size: 11px;">{{ s.name }}</code>
                  </td>
                  <td class="pe-4 py-3">
                    <input type="text" name="{{ s.name }}" class="form-control rounded-3" value="{{ s.val }}">
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <div class="p-3 bg-light border-top d-flex justify-content-end">
            <button type="submit" class="btn btn-indigo rounded-pill px-4 shadow-sm">
              <i class="bi bi-check-lg me-1"></i> Guardar Datos Bancarios
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endif %}
{% endblock %}

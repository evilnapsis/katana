{% extends "layouts/admin.html.twig" %}

{% block title %}Configuración General{% endblock %}
{% block nav_settings %}active{% endblock %}

{% block content %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
  <div>
    <h2 class="h3 fw-bold text-indigo-900 mb-1">
      <i class="bi bi-gear me-2 text-indigo-600"></i> Configuración del Sistema
    </h2>
    <p class="text-muted small mb-0">Variables globales, moneda, impuestos y parámetros operativos de la tienda.</p>
  </div>
  <div class="btn-group shadow-sm rounded-pill p-1 bg-white border" role="group">
    <a href="{{ base_url }}/settings" class="btn btn-indigo rounded-pill px-3 py-1 btn-sm">
      <i class="bi bi-sliders me-1"></i> General
    </a>
    <a href="{{ base_url }}/settings/payment" class="btn btn-light rounded-pill px-3 py-1 btn-sm text-muted">
      <i class="bi bi-credit-card me-1"></i> Métodos de Pago
    </a>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
      <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold text-white"><i class="bi bi-toggles me-2 text-indigo-400"></i> Parámetros de la Tienda</span>
        <span class="badge bg-secondary rounded-pill">{{ settings|length }} variables</span>
      </div>
      <div class="card-body p-0">
        <form method="post" action="{{ base_url }}/settings/update">
          {{ csrf_field() }}
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light text-muted small text-uppercase">
                <tr>
                  <th class="ps-4" style="width: 35%;">Atributo / Parámetro</th>
                  <th class="pe-4">Valor Configurado</th>
                </tr>
              </thead>
              <tbody>
                {% for s in settings %}
                <tr>
                  <td class="ps-4">
                    <div class="fw-bold text-dark">{{ s.label }}</div>
                    <code class="text-muted small font-monospace" style="font-size: 11px;">{{ s.name }}</code>
                  </td>
                  <td class="pe-4 py-3">
                    <input type="text" name="{{ s.name }}" class="form-control rounded-3" value="{{ s.val }}">
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <div class="p-3 bg-light border-top d-flex justify-content-end">
            <button type="submit" class="btn btn-indigo rounded-pill px-4 shadow-sm">
              <i class="bi bi-check-lg me-1"></i> Guardar Configuración
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% extends "layouts/admin.html.twig" %}

{% block title %}Nuevo Producto{% endblock %}
{% block nav_products %}active{% endblock %}

{% block content %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
  <div>
    <h2 class="h3 fw-bold text-indigo-900 mb-1">
      <i class="bi bi-plus-circle me-2 text-indigo-600"></i> Nuevo Producto
    </h2>
    <p class="text-muted small mb-0">Completa la información básica, precio, categoría e imagen para dar de alta el producto.</p>
  </div>
  <a href="{{ base_url }}/products" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
    <i class="bi bi-arrow-left me-1"></i> Volver a Productos
  </a>
</div>

<div class="row">
  <div class="col-12">
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
      <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold text-white"><i class="bi bi-file-earmark-plus me-2 text-indigo-400"></i> Formulario de Alta</span>
        <span class="badge bg-indigo-50 text-indigo-600 rounded-pill">Campos requeridos *</span>
      </div>
      <div class="card-body p-4">
        <form method="post" enctype="multipart/form-data" action="{{ base_url }}/product/create">
          {{ csrf_field() }}
          <div class="row g-3 mb-3">
            <div class="col-md-8">
              <label for="name" class="form-label fw-semibold small text-muted">Nombre del Producto <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="name" id="name" placeholder="Ej. Laptop Gamer 16GB RAM" required>
            </div>
            <div class="col-md-4">
              <label for="code" class="form-label fw-semibold small text-muted">Código / SKU</label>
              <input type="text" class="form-control" name="code" id="code" placeholder="Ej. PROD-001">
            </div>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label fw-semibold small text-muted">Descripción Detallada</label>
            <textarea class="form-control" id="description" placeholder="Describe las características y especificaciones del producto..." rows="5" name="description"></textarea>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="price" class="form-label fw-semibold small text-muted">Precio de Venta <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted">{{ coin }}</span>
                <input type="number" step="0.01" class="form-control" placeholder="0.00" required name="price" id="price">
              </div>
            </div>
            <div class="col-md-6">
              <label for="category_id" class="form-label fw-semibold small text-muted">Categoría <span class="text-danger">*</span></label>
              <select class="form-select" name="category_id" id="category_id" required>
                <option value="">-- SELECCIONAR CATEGORÍA --</option>
                {% for cat in categories %}
                  <option value="{{ cat.id }}">{{ cat.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="unit_id" class="form-label fw-semibold small text-muted">Unidad de Medida <span class="text-danger">*</span></label>
              <select class="form-select" name="unit_id" id="unit_id" required>
                <option value="">-- SELECCIONAR UNIDAD --</option>
                {% for u in units %}
                  <option value="{{ u.id }}">{{ u.name }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-6">
              <label for="image" class="form-label fw-semibold small text-muted">Imagen Principal</label>
              <input class="form-control" type="file" name="image" id="image" accept="image/*">
              <div class="form-text small">Formatos recomendados: JPG, PNG o WEBP.</div>
            </div>
          </div>

          <div class="row g-3 mb-4 p-3 bg-light rounded-3 border">
            <div class="col-md-4">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="is_public" id="is_public" checked>
                <label class="form-check-label fw-semibold text-dark" for="is_public">Publicar en tienda</label>
                <div class="form-text small" style="font-size: 11px;">Visible para todos los clientes</div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="in_existence" id="in_existence" checked>
                <label class="form-check-label fw-semibold text-dark" for="in_existence">En existencia</label>
                <div class="form-text small" style="font-size: 11px;">Disponible para compra inmediata</div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="is_featured" id="is_featured">
                <label class="form-check-label fw-semibold text-dark" for="is_featured">Producto destacado</label>
                <div class="form-text small" style="font-size: 11px;">Aparecerá en el inicio de la tienda</div>
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <a href="{{ base_url }}/products" class="btn btn-light rounded-pill px-4">Cancelar</a>
            <button type="submit" class="btn btn-indigo rounded-pill px-4 shadow-sm">
              <i class="bi bi-check-lg me-1"></i> Guardar Producto
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}

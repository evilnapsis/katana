{% extends "layouts/admin.html.twig" %}

{% block title %}Editar Usuario - {{ editUser.name }}{% endblock %}
{% block nav_users %}active{% endblock %}

{% block content %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
  <div>
    <h2 class="h3 fw-bold text-indigo-900 mb-1">
      <i class="bi bi-person-gear me-2 text-indigo-600"></i> Editar Usuario
    </h2>
    <p class="text-muted small mb-0">Actualiza las credenciales, rol y estado de la cuenta #{{ editUser.id }}.</p>
  </div>
  <a href="{{ base_url }}/users" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
    <i class="bi bi-arrow-left me-1"></i> Volver a Usuarios
  </a>
</div>

<div class="row">
  <div class="col-12">
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
      <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold text-white"><i class="bi bi-person-fill-gear me-2 text-indigo-400"></i> Editando Usuario: {{ editUser.name }} {{ editUser.lastname }}</span>
        <span class="badge bg-indigo-50 text-indigo-600 rounded-pill">ID #{{ editUser.id }}</span>
      </div>
      <div class="card-body p-4">
        <form method="post" action="{{ base_url }}/user/{{ editUser.id }}/update">
          {{ csrf_field() }}
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="name" class="form-label fw-semibold small text-muted">Nombre(s) <span class="text-danger">*</span></label>
              <input type="text" name="name" value="{{ editUser.name }}" class="form-control" id="name" required>
            </div>
            <div class="col-md-6">
              <label for="lastname" class="form-label fw-semibold small text-muted">Apellidos <span class="text-danger">*</span></label>
              <input type="text" name="lastname" value="{{ editUser.lastname }}" required class="form-control" id="lastname">
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="username" class="form-label fw-semibold small text-muted">Nombre de Usuario <span class="text-danger">*</span></label>
              <input type="text" name="username" value="{{ editUser.username }}" class="form-control" required id="username">
            </div>
            <div class="col-md-6">
              <label for="email" class="form-label fw-semibold small text-muted">Correo Electrónico <span class="text-danger">*</span></label>
              <input type="email" name="email" value="{{ editUser.email }}" class="form-control" id="email" required>
            </div>
          </div>

          <div class="mb-4">
            <label for="password" class="form-label fw-semibold small text-muted">Nueva Contraseña</label>
            <input type="password" name="password" class="form-control" id="password" placeholder="••••••••">
            <div class="form-text small text-muted">Deja este campo vacío para conservar la contraseña actual sin cambios.</div>
          </div>

          <div class="row g-3 mb-4 p-3 bg-light rounded-3 border">
            <div class="col-md-6">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="is_active" id="is_active" {% if editUser.is_active %}checked{% endif %}>
                <label class="form-check-label fw-semibold text-dark" for="is_active">Usuario Activo</label>
                <div class="form-text small" style="font-size: 11px;">Permitir iniciar sesión en el panel</div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="is_admin" id="is_admin" {% if editUser.is_admin %}checked{% endif %}>
                <label class="form-check-label fw-semibold text-dark" for="is_admin">Privilegios de Administrador</label>
                <div class="form-text small" style="font-size: 11px;">Acceso sin restricciones a todos los módulos</div>
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 pt-2">
            <a href="{{ base_url }}/users" class="btn btn-light rounded-pill px-4">Cancelar</a>
            <button type="submit" class="btn btn-indigo rounded-pill px-4 shadow-sm">
              <i class="bi bi-check-lg me-1"></i> Guardar Cambios
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}

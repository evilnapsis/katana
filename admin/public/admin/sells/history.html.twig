{% extends "layouts/admin.html.twig" %}

{% block title %}Historial de Pedido #{{ buy_id }}{% endblock %}
{% block nav_sells %}active{% endblock %}

{% block content %}
<div class="row mb-3">
  <div class="col-md-12 d-flex justify-content-between align-items-center">
    <div>
      <h2>HISTORIAL</h2>
      <h4>Compra #{{ buy_id }}</h4>
    </div>
    <a href="{{ base_url }}/sells" class="btn btn-secondary">
      <i class="bi bi-arrow-left pe-2"></i> Volver a Ventas
    </a>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <div class="card mb-4">
      <div class="card-header">
        <i class="bi bi-list-task pe-2"></i> Operaciones
      </div>
      <div class="card-body">
        {% if history|length > 0 %}
        <div class="table-responsive">
          <table class="table table-bordered mb-0">
            <thead class="table-light">
              <tr>
                <th>Estado</th>
                <th>Fecha</th>
              </tr>
            </thead>
            <tbody>
              {% for h in history %}
              <tr>
                <td>{{ h.getStatus().name }}</td>
                <td>{{ h.created_at }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <p class="alert alert-warning mb-0">No hay historial para este pedido.</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endblock %}

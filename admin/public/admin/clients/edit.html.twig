{% extends "layouts/admin.html.twig" %}

{% block title %}Editar Cliente - {{ client.getFullname() }}{% endblock %}
{% block nav_clients %}active{% endblock %}

{% block content %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
  <div>
    <h2 class="h3 fw-bold text-indigo-900 mb-1">
      <i class="bi bi-pencil-square me-2 text-indigo-600"></i> Editar Cliente
    </h2>
    <p class="text-muted small mb-0">Actualiza los datos personales, de contacto y dirección del cliente #{{ client.id }}.</p>
  </div>
  <a href="{{ base_url }}/clients" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
    <i class="bi bi-arrow-left me-1"></i> Volver a Clientes
  </a>
</div>

<div class="row">
  <div class="col-12">
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
      <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold text-white"><i class="bi bi-person-gear me-2 text-indigo-400"></i> Editando: {{ client.getFullname() }}</span>
        <span class="badge bg-indigo-50 text-indigo-600 rounded-pill">ID #{{ client.id }}</span>
      </div>
      <div class="card-body p-4">
        <form method="post" action="{{ base_url }}/client/{{ client.id }}/update">
          {{ csrf_field() }}
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="name" class="form-label fw-semibold small text-muted">Nombre(s) <span class="text-danger">*</span></label>
              <input type="text" name="name" required value="{{ client.name }}" class="form-control" id="name">
            </div>
            <div class="col-md-6">
              <label for="lastname" class="form-label fw-semibold small text-muted">Apellidos <span class="text-danger">*</span></label>
              <input type="text" name="lastname" value="{{ client.lastname }}" required class="form-control" id="lastname">
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="email" class="form-label fw-semibold small text-muted">Correo Electrónico <span class="text-danger">*</span></label>
              <input type="email" name="email" required value="{{ client.email }}" class="form-control" id="email">
            </div>
            <div class="col-md-6">
              <label for="phone" class="form-label fw-semibold small text-muted">Teléfono de Contacto</label>
              <input type="text" name="phone" value="{{ client.phone }}" class="form-control" id="phone">
            </div>
          </div>

          <div class="mb-3">
            <label for="address" class="form-label fw-semibold small text-muted">Dirección de Envío Principal</label>
            <input type="text" name="address" value="{{ client.address }}" class="form-control" id="address">
          </div>

          <div class="mb-4">
            <label for="password" class="form-label fw-semibold small text-muted">Nueva Contraseña</label>
            <input type="password" name="password" class="form-control" id="password" placeholder="••••••••">
            <div class="form-text small text-muted">Deja este campo en blanco para conservar la contraseña actual sin cambios.</div>
          </div>

          <div class="d-flex justify-content-end gap-2 pt-2">
            <a href="{{ base_url }}/clients" class="btn btn-light rounded-pill px-4">Cancelar</a>
            <button type="submit" class="btn btn-indigo rounded-pill px-4 shadow-sm">
              <i class="bi bi-check-lg me-1"></i> Guardar Cambios
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}

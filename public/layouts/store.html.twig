<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta http-equiv="X-UA-Compatible" content="ie=edge"/>
    <title>Katana Lite - {% block title %}Tienda Online{% endblock %}</title>
    <link href="{{ base_url }}/assets/tabler/css/tabler.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="{{ base_url }}/assets/bootstrap-icons/bootstrap-icons.css">
    <script src="{{ base_url }}/assets/jquery/jquery.min.js"></script>
    <style>
      @import url('https://rsms.me/inter/inter.css');
      :root {
        --tblr-font-sans-serif: 'Inter Var', -apple-system, BlinkMacSystemFont, San Francisco, Segoe UI, Roboto, Helvetica Neue, sans-serif;
      }
      body {
        font-feature-settings: "cv03", "cv04", "cv11";
      }
      .hover-translate-y-n3:hover {
        transform: translateY(-5px);
        transition: transform 0.2s ease-in-out;
      }
    </style>
  </head>
  <body>
    <div class="page">
      <!-- Navbar -->
      <header class="navbar navbar-expand-md d-print-none shadow-sm">
        <div class="container-xl">
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <h1 class="navbar-brand navbar-brand-autodark pe-0 pe-md-3">
            <a href="{{ base_url }}/" class="text-decoration-none d-flex align-items-center">
              <i class="bi bi-shop text-primary me-2 h1 mb-0"></i>
              <span class="h2 mb-0">KATANA LITE <span class="text-primary">SHOP</span></span>
            </a>
          </h1>
          <div class="navbar-nav flex-row order-md-last">
            <div class="nav-item d-none d-md-flex me-3">
              <a href="{{ base_url }}/cart" class="nav-link px-0" title="Ver Carrito">
                <i class="bi bi-cart3 h2 mb-0"></i>
                {% if session.cart is defined and session.cart|length > 0 %}
                <span class="badge bg-red rounded-pill badge-notification">{{ session.cart|length }}</span>
                {% endif %}
              </a>
            </div>

            {% if session.client_id %}
            <div class="nav-item dropdown ps-3">
              <a href="#" class="nav-link d-flex lh-1 p-0 px-2" data-bs-toggle="dropdown">
                <span class="avatar avatar-sm bg-primary text-white rounded-circle shadow-sm">
                  <i class="bi bi-person"></i>
                </span>
                <div class="d-none d-xl-block ps-2 text-start">
                  <div class="small fw-bold text-dark">{{ session.client_name }}</div>
                  <div class="mt-1 small text-muted" style="font-size: 10px;">MI CUENTA</div>
                </div>
              </a>
              <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow shadow-lg border-0">
                <a href="{{ base_url }}/account" class="dropdown-item"><i class="bi bi-bag me-2"></i> Mis Compras</a>
                <div class="dropdown-divider"></div>
                <a href="{{ base_url }}/logout" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión</a>
              </div>
            </div>
            {% else %}
            <div class="nav-item d-none d-md-flex">
              <a href="{{ base_url }}/login" class="btn btn-link text-dark me-2">Entrar</a>
              <a href="{{ base_url }}/register" class="btn btn-primary shadow-sm px-4">Registro</a>
            </div>
            {% endif %}
          </div>
        </div>
      </header>

      <header class="navbar-expand-md border-bottom bg-white shadow-sm sticky-top">
        <div class="collapse navbar-collapse" id="navbar-menu">
          <div class="navbar">
            <div class="container-xl">
              <ul class="navbar-nav">
                <li class="nav-item">
                  <a class="nav-link" href="{{ base_url }}/">
                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="bi bi-house"></i></span>
                    <span class="nav-link-title">Inicio</span>
                  </a>
                </li>
                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownCat" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="bi bi-grid"></i></span>
                    <span class="nav-link-title">Categorías</span>
                  </a>
                  <div class="dropdown-menu shadow-lg border-0" aria-labelledby="navbarDropdownCat">
                    {% for cat in nav_categories %}
                      <a class="dropdown-item fw-semibold text-dark" href="{{ base_url }}/category/{{ cat.short_name }}">
                        <i class="bi bi-tag-fill me-2 text-primary"></i> {{ cat.name }}
                      </a>
                    {% endfor %}
                  </div>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="{{ base_url }}/contact">
                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="bi bi-chat-dots"></i></span>
                    <span class="nav-link-title">Contacto</span>
                  </a>
                </li>
              </ul>
              <div class="my-2 my-md-0 flex-grow-1 flex-md-grow-0 order-first order-md-last me-md-3">
                <form action="{{ base_url }}/products" method="get" autocomplete="off" novalidate>
                  <div class="input-icon">
                    <span class="input-icon-addon"><i class="bi bi-search"></i></span>
                    <input type="text" name="q" class="form-control rounded-3 border-light bg-light shadow-none" placeholder="Buscar productos..." aria-label="Search">
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </header>

      <div class="page-wrapper pt-4">
        {% for type, message in flashes %}
        <div class="container-xl">
          <div class="alert alert-{{ type == 'error' ? 'danger' : (type == 'success' ? 'success' : 'info') }} alert-dismissible" role="alert">
            {{ message }}
          </div>
        </div>
        {% endfor %}

        {% block content %}{% endblock %}

        <footer class="footer footer-transparent d-print-none bg-dark text-white py-5 mt-6">
          <div class="container-xl">
            <div class="row text-center align-items-center flex-row-reverse">
              <div class="col-lg-auto ms-lg-auto">
                <ul class="list-inline list-inline-dots mb-0">
                  <li class="list-inline-item"><a href="{{ base_url }}/contact" class="text-white-50 text-decoration-none">Soporte</a></li>
                  <li class="list-inline-item text-white-50">Términos y Condiciones</li>
                </ul>
              </div>
              <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                <ul class="list-inline list-inline-dots mb-0">
                  <li class="list-inline-item text-white-50">
                    &copy; 2026 <strong>KATANA LITE</strong>. Todos los derechos reservados.
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </footer>
      </div>
    </div>

    <script src="{{ base_url }}/assets/tabler/js/tabler.min.js" defer></script>
    {% block scripts %}{% endblock %}
  </body>
</html>
